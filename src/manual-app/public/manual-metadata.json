  "config": {
    "site": {
      "title": "Wave Manual",
      "titleEn": "Wave Manual",
      "description": "Wave 面向 UI/UX 设计师的本地设计交付手册。",
      "descriptionEn": "A local design delivery manual for UI/UX designers using Wave.",
      "basePath": "/"
    },
    "home": {
      "cards": [
        {
          "title": "Design Token",
          "titleEn": "Design Token",
          "description": "读取带 $config 的 main.yaml，生成 json、jsonc、css 和 sketch 输出。",
          "descriptionEn": "Read a main.yaml with $config and generate json, jsonc, css, and Sketch outputs.",
          "href": "/design-token",
          "command": "wave token"
        },
        {
          "title": "素材压缩",
          "titleEn": "Asset compression",
          "description": "压缩 PNG、JPG、SVG 和 GIF，支持 dry-run、递归扫描和 SVG 图标清洗。",
          "descriptionEn": "Compress PNG, JPG, SVG, and GIF assets with dry runs, recursive scans, and SVG cleanup.",
          "href": "/compress",
          "command": "wave compress --help"
        },
        {
          "title": "动效生成",
          "titleEn": "Motion generation",
          "description": "从 PNG 帧目录生成 GIF 或 APNG。",
          "descriptionEn": "Create GIF or APNG animations from a directory of PNG frames.",
          "href": "/motion",
          "command": "wave motion --help"
        },
        {
          "title": "工作区创建",
          "titleEn": "Workspace creation",
          "description": "按本地配置创建设计项目目录。",
          "descriptionEn": "Create a design project workspace from local configuration.",
          "href": "/workspace",
          "command": "wave workspace --help"
        }
      ]
    }
  }
