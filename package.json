{
	"name": "wave",
	"version": "0.19.0",
	"description": "A CLI tool for generating design tokens",
	"type": "module",
	"module": "src/index.ts",
	"main": "src/index.ts",
	"bin": {
		"wave": "./src/index.ts"
	},
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"dev": "bun run src/index.ts",
		"manual:dev": "vite --host 127.0.0.1 src/manual-app",
		"manual:build": "bun run scripts/build-manual.ts",
		"build:cli": "bun run scripts/build-cli.ts",
		"build": "pnpm manual:build && pnpm build:cli",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
		"test": "bun test",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --fix .",
		"check": "biome check --write .",
		"check:style": "biome check .",
		"check:ci": "pnpm typecheck && pnpm test && pnpm build && pnpm check:style",
		"bench": "bun benchmarks/design-token/run.ts --mode default --iterations 5 --warmup 1",
		"bench:smoke": "bun benchmarks/design-token/run.ts --mode smoke --iterations 1 --warmup 0",
		"bench:baseline": "bun benchmarks/design-token/run.ts --mode default --iterations 10 --warmup 2 --run-id design-token-baseline",
		"bench:stress": "bun benchmarks/design-token/run.ts --mode stress --iterations 3 --warmup 1 --no-equivalence",
		"bench:compare": "bun benchmarks/compare.ts",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"keywords": [
		"design-tokens",
		"cli"
	],
	"author": "ttao",
	"license": "MIT",
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"chroma-js": "^3.1.2",
		"commander": "^13.0.0",
		"js-yaml": "^4.1.0",
		"picocolors": "^1.1.0",
		"yocto-spinner": "^1.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@changesets/cli": "^2.30.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "latest",
		"@types/chroma-js": "^3.1.0",
		"@types/js-yaml": "^4.0.9",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"gray-matter": "^4.0.3",
		"happy-dom": "^20.10.6",
		"marked": "^18.0.5",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "^5",
		"vite": "^6.4.3"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
